{
  "$schema": "https://opencode.ai/config.json",

  // Variantes de modelo usadas por los agentes de este proyecto.
  // En OpenCode V2 `temperature` y `top_p` NO se configuran a nivel de agente:
  // se definen aquí, en la variante del modelo, y el agente la referencia con `#id`.
  "providers": {
    "opencode": {
      "models": {
        "beam-free": {
          "variants": [
            {
              "id": "review-profile",
              // Revisión determinista: hallazgos verificables, sin creatividad.
              "body": {
                "temperature": 0.0,
                "top_p": 0.1
              }
            }
          ]
        },
        "flint-40b-free": {
          "variants": [
            {
              "id": "coordinator-strict",
              // Determinista y enfocado: el coordinador planifica, no improvisa.
              "body": {
                "temperature": 0.0,
                "top_p": 0.1
              }
            }
          ]
        },
        "deepseek-v4.1-flash-free": {
          "variants": [
            {
              "id": "senior-developer-profile",
              // Margen justo para proponer diseño sin romper la lógica del código.
              "body": {
                "temperature": 0.3,
                "top_p": 0.15
              }
            }
          ]
        },
        "minimax-m3.1-flash-free": {
          "variants": [
            {
              "id": "review-profile",
              // Revisión determinista: hallazgos verificables, sin creatividad.
              "body": {
                "temperature": 0.1,
                "top_p": 0.15
              }
            }
          ]
        },
        "nemotron-3.5-lightning-free": {
          "variants": [
            {
              "id": "coordinator-strict",
              // Determinista y enfocado: el coordinador planifica, no improvisa.
              "body": {
                "temperature": 0.0,
                "top_p": 0.1
              }
            }
          ]
        }
      }
    },
	{
		"ollama": {
		  "baseUrl": "http://localhost:11434",
		  "models": {
			"qwen3.5:9b": {
			  "name": "Qwen 3.5 9b (Local Ollama)",
			  "tools": true,
			  "options": {
				"num_ctx": 32768
			  }
			},
			"qwen3.5-9b-optimizado:latest": {
			  "name": "Qwen 3.5 9b Optimizado (Local Ollama)",
			  "tools": true,
			  "options": {
				"num_ctx": 32768
			  }
			},
			"qwen2.5-coder:7b": {
			  "name": "Qwen 2.5 Coder 7b (Local Ollama)",
			  "tools": true,
			  "options": {
				"num_ctx": 32768
			  }
			},
			"qwen2.5-coder-7b-optimizado:latest": {
			  "name": "Qwen 2.5 Coder 7b Optimizado (Local Ollama)",
			  "tools": true,
			  "options": {
				"num_ctx": 32768
			  }
			}
		  }
		}
	},
	"model": "qwen2.5-coder-7b-optimizado:latest",
	  "permission": {
			"*": "deny",
			"read": "allow",
			"edit": "ask",
			"grep": "ask",
			"glob": "ask",
			"list": "ask"
	  }
  }
}
